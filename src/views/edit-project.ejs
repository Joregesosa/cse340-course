<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <p>Edit the details below to update the service project.</p>

  <form action="/edit-project/<%= project.project_id %>" method="POST" class="form-card">
    <div class="form-group">
      <label for="title">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        placeholder="e.g. Community Garden Cleanup"
        maxlength="150"
        required
        value="<%= project.title %>"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        placeholder="What will volunteers do?"
        maxlength="500"
        required
      ><%= project.description %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        placeholder="e.g. 123 Main St, Springfield"
        maxlength="255"
        required
        value="<%= project.location %>"
      />
    </div>

    <div class="form-group">
      <label for="date">Date</label>
      <input
        type="date"
        id="date"
        name="date"
        required
        value="<%= new Date(project.date).toISOString().split('T')[0] %>"
      />
    </div>

    <div class="form-group">
      <label for="organizationId">Organization</label>
      <select
        id="organizationId"
        name="organizationId"
        required
      >
        <option value="">Select an organization</option>
        <% organizations.forEach(org => { %>
          <option
            value="<%= org.organization_id %>"
            <%= org.organization_id === project.organization_id ? 'selected' : '' %>
          ><%= org.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Update Project</button>
      <a href="/projects" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
