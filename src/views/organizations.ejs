<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <p>Here are a few of our partner organizations:</p>
  <ul>
    <% 
      organizations.forEach(org => { %>
      <li>
        <img
          src="/images/<%= org.logo_filename %>"
          alt="<%= org.name %> logo"
        />
        <a href="/organization/<%= org.organization_id %>"><%= org.name %></a>
        :<%= org.contact_email %>
      </li>
      <% })  
    %> 
  </ul>
  <div class="page-actions">
    <a href="/new-organization" class="btn btn-primary">+ Add a new organization</a>
  </div>
</main>
<%- include('partials/footer') %>