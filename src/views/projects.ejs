<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <h2>Upcoming Service Projects</h2>
  <ul>
    <% projects.forEach(pr => { %>
        <li>
          <strong>Project:</strong>
          <a href="/project/<%= pr.project_id %>"><%= pr.title %></a> 
          <br>
          <strong>Partner Organization:</strong>
          <a href="/organization/<%= pr.organization_id %>"><%= pr.name %></a>
        </li>
    <% })%>  
  </ul>
  <p><a href="/new-project">Add a New Service Project</a></p>
</main>
<%- include('partials/footer') %>
