<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <p>Fill in the details below to edit this partner organization.</p>

  <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST" class="form-card">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder="e.g. Green Earth Alliance"
        required
        maxlength="150"
        value="<%= organizationDetails.name %>"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        placeholder="What does this organization do?"
        required
        maxlength="500"
      ><%= organizationDetails.description %></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input
        type="email"
        id="contactEmail"
        name="contactEmail"
        placeholder="contact@example.org"
        required
        maxlength="255"
        value="<%= organizationDetails.contact_email %>"
      />
    </div> 
    
    <div class="form-group">
      <label for="logoFilename">Logo Filename</label>
      <input
        type="text"
        id="logoFilename"
        name="logoFilename"
        placeholder="e.g. logo.png"
        required
        maxlength="255"
        value="<%= organizationDetails.logo_filename %>"
      />
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Update Organization</button>
      <a href="/organizations" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
