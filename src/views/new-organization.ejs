<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <p>Fill in the details below to add a new partner organization.</p>

  <form action="/new-organization" method="POST" class="form-card">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder="e.g. Green Earth Alliance"
        required
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        placeholder="What does this organization do?"
        required
      ></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input
        type="email"
        id="contactEmail"
        name="contactEmail"
        placeholder="contact@example.org"
        required
      />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Create Organization</button>
      <a href="/organizations" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
