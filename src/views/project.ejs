<%- include('partials/header') %>
<main>
    <h1><%= project.title %></h1>

    <p><strong>Description:</strong> <%= project.description %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p>
        <strong>Partner Organization:</strong>
        <a href="/organization/<%= project.organization_id %>"><%= project.name %></a>
    </p>

    <h2>Tags:</h2>
        <ul>
        <% categories.forEach(cat => { %>
            <li><a href="/category/<%= cat.category_id %>"><%= cat.name %></a></li>
        <% }) %>
    </ul>
    <div class="page-actions">
        <a href="/assign-categories/<%= project.project_id %>" class="btn btn-secondary">Edit Categories</a>
        <a href="/new-project" class="btn btn-primary">+ Add a New Service Project</a>
    </div>
</main>
<%- include('partials/footer') %>
